NEXT_PUBLIC_DOSSIERFACILE_LOCATAIRE_URL=https://locataire.dossierfacile.example.com
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_GITBOOK_URL=https://gitbook.example.com/e2e

SENTRY_CSP_REPORT_URI=https://sentry.example.com/api/1/security/?sentry_key=e2e
CRON_FAILURE_EMAILS=
ACCOMMODATION_REPORT_EMAIL=
SUPPORT_TICKET_EMAIL=

