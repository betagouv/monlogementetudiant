# Environnement des tests e2e (chargé par playwright.config.ts et le seed).
# Versionné et indépendant du .env local : les variables déjà définies dans le shell (CI) priment.
# Les services externes pointent vers un port fermé : aucun appel ne sort (Brevo, géocodage, etc.).

BASE_URL=http://localhost:3210
AUTH_SECRET=e2e-auth-secret
DATABASE_URL=postgres://test:test@localhost:5491/mle_e2e
DATABASE_URL_TEST=postgres://test:test@localhost:5491/mle_e2e

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_TALLY_URL=https://tally.example.com/e2e
